+    ''|*[!0-9]*) abort "Unable to determine new boot image size. Aborting...";;
+  esac;
+
+  partition_size="$(blockdev --getsize64 "$BLOCK" 2>/dev/null)";
+  case "$partition_size" in
+    ''|*[!0-9]*) abort "Unable to determine target boot partition size. Aborting...";;
+  esac;
