+    abort "Unexpected boot partition size: $partition_size bytes (expected $boot_partition_size). Aborting...";
+  elif [ "$image_size" -gt "$partition_size" ]; then
+    abort "New boot image is too large: $image_size > $partition_size bytes. Aborting...";
